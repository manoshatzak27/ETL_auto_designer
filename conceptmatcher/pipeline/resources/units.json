    "umoll":     {"type": "concentration", "expansion": "micromole per liter"},
    "meql":      {"type": "concentration", "expansion": "milliequivalent per liter"},
    "iul":       {"type": "concentration", "expansion": "international unit per liter"},
    "kgm2":      {"type": "index",         "expansion": "kilogram per square meter"},
    "mlmin":     {"type": "rate",          "expansion": "milliliter per minute"},
    "lmin":      {"type": "rate",          "expansion": "liter per minute"}
  },

  "_concatenated_comment": [
    "The *dl / *ml / *l run above are the separator-free spellings that survive",
    "a column identifier: glucose_mgdl, egfr_mlmin, bmi_kgm2. They are listed",
    "explicitly rather than derived, so no rule can accidentally read a real",
    "word as a squashed unit."
  ],

  "_omitted_comment": [
    "'ratio' and 'score' are deliberately NOT units here. They read as units",
    "but they are load-bearing tokens in a concept name ('albumin creatinine",
    "ratio', 'Glasgow coma scale score'), and Step 0.3 strips whatever it",
    "classifies as a unit out of the search string."
  ],

  "_expected_units_comment": [
    "Step 7.2 sanity table: for a handful of very common measurement concepts,",
    "which unit TYPES are plausible. Matched by keyword against the selected",
    "concept name; anything not listed here is not checked (absence of a rule",
    "is not evidence of a mismatch)."
  ],
  "expected_unit_types": {
