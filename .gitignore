# Environment / secrets
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/venv/
backend/.venv/

# Wizard state / runtime data
#
# These are normally shadowed by Docker named volumes (uploads_data/outputs_data),
# but the host-side directories themselves must keep existing on disk (even empty) —
# on this Docker setup, deleting the host anchor dir severs the nested volume mount
# for any already-running container, not just its contents. Never rmdir these.
backend/uploads/
backend/outputs/
backend/etl_designer.db
backend/etl_designer.db-journal

# Postgres docker volume
pgdata/

# Athena vocab bundle (user-supplied) + EntityLinker FAISS / embedding caches
vocab_bundle/
embeddings_*.npy
faiss_*.index
lookup_*.csv

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
