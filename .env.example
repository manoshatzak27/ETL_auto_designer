# ──────────────────────────────────────────────────────────────────────────────
# OMOP ETL Auto-Designer — environment variables.
# Copy to `.env` at the repo root and fill in.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required for code generation + AI chat) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Postgres (OMOP target DB) ────────────────────────────────────────────────
POSTGRES_USER=omop
POSTGRES_PASSWORD=omop_pwd
POSTGRES_DB=omop
POSTGRES_PORT=5432
OMOP_SCHEMA=cdm
OMOP_VOCAB_SCHEMA=vocab

# ── Athena vocabulary bundle (used by the Finalize step vocab loader) ────────
# Path on the host that contains the Athena export CSVs (tab-delimited):
#   CONCEPT.csv, VOCABULARY.csv, DOMAIN.csv, CONCEPT_CLASS.csv, RELATIONSHIP.csv,
#   CONCEPT_RELATIONSHIP.csv, CONCEPT_SYNONYM.csv, CONCEPT_ANCESTOR.csv,
#   DRUG_STRENGTH.csv
# Bind-mounted into the backend at /vocab (read-only).
ATHENA_BUNDLE_PATH=./vocab_bundle

# Allow-list root for /load-vocabulary (inside the backend container).
# Defaults to /vocab to match the bind-mount above.
ATHENA_BUNDLE_ROOT=/vocab

# Allow-list root for /load-mappings-from-dir. Leave empty to restrict to the
# project's own uploads/ directory (safest default).
MAPPINGS_BUNDLE_ROOT=

# ── Concept matcher (every concept search + Concepts step → "Load concepts") ─
# The staged OMOP matching pipeline in ./conceptmatcher, run as the
# `conceptmatcher` service.
#
# Set to 0 to build the small (~310MB) image without CPU torch. Stage 5 is
# then skipped and its 20% weight redistributed.
CONCEPT_MATCHER_EMBEDDINGS=1
#
# It reads the vocabulary above from the same Postgres. Once that is loaded,
# and after every reload, build its search structures with:
#   ./scripts/setup-conceptmatcher.sh && docker compose restart conceptmatcher

# ── Port overrides (optional) ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
CONCEPT_MATCHER_PORT=8002
