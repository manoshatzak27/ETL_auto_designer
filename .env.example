# ──────────────────────────────────────────────────────────────────────────────
# OMOP ETL Auto-Designer — environment variables.
# Copy to `.env` at the repo root and fill in.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required for code generation + AI chat) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Postgres (OMOP target DB) ────────────────────────────────────────────────
POSTGRES_USER=omop
POSTGRES_PASSWORD=omop_pwd
POSTGRES_DB=omop
POSTGRES_PORT=5432
OMOP_SCHEMA=cdm
OMOP_VOCAB_SCHEMA=vocab

# ── Athena vocabulary bundle (used by Step 12 vocab loader AND EntityLinker) ─
# Path on the host that contains the Athena export CSVs (tab-delimited):
#   CONCEPT.csv (used by both)
#   VOCABULARY.csv, DOMAIN.csv, CONCEPT_CLASS.csv, RELATIONSHIP.csv,
#   CONCEPT_RELATIONSHIP.csv, CONCEPT_SYNONYM.csv, CONCEPT_ANCESTOR.csv,
#   DRUG_STRENGTH.csv  (used by Step 12 vocab loader)
# Bind-mounted into:
#   - backend at /vocab (read-only) — Step 12 vocabulary load
#   - entitylinker at /data (read-write) — also stores FAISS index + embedding cache
ATHENA_BUNDLE_PATH=./vocab_bundle

# Allow-list root for /load-vocabulary (inside the backend container).
# Defaults to /vocab to match the bind-mount above.
ATHENA_BUNDLE_ROOT=/vocab

# Allow-list root for /load-mappings-from-dir. Leave empty to restrict to the
# project's own uploads/ directory (safest default).
MAPPINGS_BUNDLE_ROOT=

# ── Port overrides (optional) ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENTITYLINKER_PORT=8001
