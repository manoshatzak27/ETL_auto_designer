# ──────────────────────────────────────────────────────────────────────────────
# OMOP ETL Auto-Designer — environment variables.
# Copy to `.env` at the repo root and fill in.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required for code generation + AI chat) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Postgres (OMOP target DB) ────────────────────────────────────────────────
POSTGRES_USER=omop
POSTGRES_PASSWORD=omop_pwd
POSTGRES_DB=omop
POSTGRES_PORT=5432
OMOP_SCHEMA=cdm
OMOP_VOCAB_SCHEMA=vocab

# ── Athena vocabulary bundle (used by Finalize step vocab loader AND EntityLinker) ─
# Path on the host that contains the Athena export CSVs (tab-delimited):
#   CONCEPT.csv (used by both)
#   VOCABULARY.csv, DOMAIN.csv, CONCEPT_CLASS.csv, RELATIONSHIP.csv,
#   CONCEPT_RELATIONSHIP.csv, CONCEPT_SYNONYM.csv, CONCEPT_ANCESTOR.csv,
#   DRUG_STRENGTH.csv  (used by Finalize step vocab loader)
# Bind-mounted into:
#   - backend at /vocab (read-only) — Finalize step vocabulary load
#   - entitylinker at /data (read-write) — also stores FAISS index + embedding cache
ATHENA_BUNDLE_PATH=./vocab_bundle

# Allow-list root for /load-vocabulary (inside the backend container).
# Defaults to /vocab to match the bind-mount above.
ATHENA_BUNDLE_ROOT=/vocab

# Allow-list root for /load-mappings-from-dir. Leave empty to restrict to the
# project's own uploads/ directory (safest default).
MAPPINGS_BUNDLE_ROOT=

# ── Concept matcher (Concepts step → "Load concepts") ────────────────────────
# The staged OMOP matching pipeline from the sibling "new concept finding"
# project, run here as the `conceptmatcher` service. Two things it needs:
#
#   1. That project's checkout, as the Docker build context.
CONCEPT_PIPELINE_PATH=../new concept finding
#      Set WITH_EMBEDDINGS to 0 to build the small (~310MB) image without CPU
#      torch. Stage 5 is then skipped and its 20% weight redistributed.
CONCEPT_MATCHER_EMBEDDINGS=1
#
#   2. That project's own Postgres — the standard-only Athena vocabulary plus
#      its `pipeline` schema, loaded there with ./load_vocab.sh and
#      ./setup_pipeline.sh. It is a separate stack on host port 5433, reached
#      from this one through the host gateway rather than duplicated.
VOCAB_DB_HOST=host.docker.internal
VOCAB_DB_PORT=5433
VOCAB_DB_NAME=athena_vocab
VOCAB_DB_USER=vocab
VOCAB_DB_PASSWORD=vocab_pwd

# ── Port overrides (optional) ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENTITYLINKER_PORT=8001
CONCEPT_MATCHER_PORT=8002
