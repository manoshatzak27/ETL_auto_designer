{
  "_comment": [
    "Stage 0.7 stopwords, split by why they are noise.",
    "",
    "The hard rule from the spec: do NOT remove domain-bearing words such as",
    "'pressure', 'test', 'level', 'rate', 'count' — they are what distinguishes",
    "'blood pressure' from 'blood glucose'. Those live in 'keep_always' below,",
    "which is applied as a veto over every other list, so no future edit can",
    "accidentally strip them.",
    "",
    "'corpus_adaptive' words are only dropped when they exceed the",
    "stopword_corpus_threshold in the config (default 0.8 = present in 80%+ of",
    "the batch being mapped) — the spec's 80% rule."
  ],

  "generic": [
    "value", "values", "result", "results", "number", "measurement",
    "measurements", "reading", "readings", "finding", "findings", "data",
    "field", "column", "code", "codes", "flag", "indicator", "info",
    "information", "detail", "details", "item", "entry", "text", "desc",
    "description", "name", "type", "category", "status", "amount", "qty",
    "quantity", "unit", "units", "measure", "measured", "observed",
    "observation_value", "raw", "clean", "final", "tmp"
  ],
  "_temp_comment": [
    "'temp' is NOT a stopword. In an ETL schema it can mean 'temporary', but in",
    "a clinical column name it almost always means temperature — and treating",
    "it as noise stripped the only content from 'temp_c'. It is an abbreviation",
    "instead; see abbreviations.json."
  ],

  "metadata": [
    "patient", "patients", "subject", "subjects", "person", "persons",
    "visit", "visits", "encounter", "encounters",
    "record", "records", "documented", "document", "documentation",
    "reported", "report", "chart", "charted", "note", "notes", "form",
    "questionnaire", "survey", "study", "trial", "site", "source", "system",
    "provider", "clinician", "physician", "nurse", "staff", "user",
    "hospital", "clinic", "ward", "department", "id", "identifier", "key",
    "pk", "fk", "index", "seq", "sequence", "row", "table",
    "loinc", "snomed", "snomedct", "icd", "icd9", "icd10", "rxnorm", "rxcui",
    "cpt", "cpt4", "hcpcs", "ndc", "atc", "omop", "vocabulary"
  ],

  "structural": [
